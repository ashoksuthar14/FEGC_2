*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
/build
/app/build
/captures
.externalNativeBuild
.cxx
local.properties

# Reference material — large binaries, kept out of git
/FEG Website screenshots/

# Kotlin compiler scratch output
.kotlin/

# On-device model weights — pushed to the phone, never committed
/models/
*.litertlm

# JVM crash dumps
hs_err_pid*.log
replay_pid*.log

# Secrets. There are none in this project, and this is how it stays that way.
# .env.example is committed on purpose and documents the absence.
.env
.env.*
!.env.example

# Submission binaries. The video stays out; the deck under demo/presentation is
# committed on purpose, because that is where the guide expects a reviewer to
# find it.
*.pptx
!demo/presentation/*.pptx
*.mp4

# AI assistant working material. Kept on the developer's machine, out of the
# submission: these are the prompts used to drive the build, not the build.
# The AI-assistance disclosure the submission requires lives in
# docs/dependencies.md, which is the right place for it.
CLAUDE.md
CLAUDE_CODE_PROMPT*.md
/Claude outputs/
