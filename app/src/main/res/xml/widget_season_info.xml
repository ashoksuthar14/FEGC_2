<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is 0 on purpose. The system minimum is thirty minutes, which is useless
  for a surface that exists to be current; every refresh comes from WidgetRefresher instead,
  driven by the engine, a protection change or a club change.
-->
<!--
  previewLayout, not previewImage: the picker then draws the real card's shape rather than the
  Glance loading placeholder. Without it every provider in this app looks identical in the
  picker, and a customer adds one widget five times instead of adding five widgets.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:description="@string/widget_season_description"
    android:previewLayout="@layout/widget_preview_season"
    android:initialLayout="@layout/glance_default_loading_layout" />
