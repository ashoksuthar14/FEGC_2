<?xml version="1.0" encoding="utf-8"?>
<!--
  Picker preview for the club card.

  It mirrors ClubMatchWidget zone for zone: club name and fixture with the crest, the minute
  in the club's accent, the score row with a club either side of the figure, the accent
  timeline, and the counts line. The one thing it cannot reproduce is the blurred crest ground
  - the launcher inflates this with no Glance and no bitmaps - so the ground is a gradient in
  the same darkened club hue. Everything else is what the card actually draws.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_club_ground"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_preview_crest_club" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HAJDUK SPLIT"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Croatia 1"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="67&#8217;"
            android:textColor="#FF7FA8E8"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Dinamo Zagreb"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:maxLines="1" />

        <View
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_preview_crest_home" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:text="1  1"
            android:textColor="#FFFFFFFF"
            android:textSize="42sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <View
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/widget_preview_crest_club" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:text="Hajduk Split"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="67"
            android:background="@drawable/widget_preview_club_bar" />

        <View
            android:layout_width="3dp"
            android:layout_height="match_parent" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="23"
            android:background="@drawable/widget_preview_track" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="1 of 3 home  ·  2. poluvrijeme"
        android:textColor="#99FFFFFF"
        android:textSize="11sp" />
</LinearLayout>
