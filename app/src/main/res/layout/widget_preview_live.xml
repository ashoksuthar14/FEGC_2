<?xml version="1.0" encoding="utf-8"?>
<!--
  Picker preview for the Live Slip widget. Static on purpose: this is the tile in the widget
  picker, not the widget. It shows the state the widget is FOR - a slip in flight - because a
  preview of the idle state is what makes a customer scroll past.

  The five previews exist because without them every entry in the picker is the same grey
  Glance loading layout, and a customer picking five identical tiles gets five copies of one
  widget. Ask how we know.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_card"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/widget_preview_crest" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:text="LIVE"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="67'"
            android:textColor="#FF35D07F"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="2 – 1"
        android:textColor="#FFFFFFFF"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Hajduk Split v Rijeka"
        android:textColor="#FF939AA8"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="@drawable/widget_preview_track_filled" />

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_track" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="3 of 4 home"
        android:textColor="#FF939AA8"
        android:textSize="12sp" />
</LinearLayout>
