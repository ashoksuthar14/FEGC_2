<?xml version="1.0" encoding="utf-8"?>
<!--
  Picker preview for the Your protection widget. Static on purpose: this is the tile in the widget
  picker, not the widget itself, and previewLayout is inflated by the launcher from a plain
  layout resource, with no Glance, no bitmaps, no state.

  It shows the state the widget is FOR, with the same shape the real card draws: header line,
  one big figure, one short subline. A preview of the empty state is what makes a customer
  scroll past.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_card"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/widget_preview_crest" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:text="YOUR PROTECTION"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHECKED"
            android:textColor="#FF35D07F"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60%"
            android:textColor="#FFF5C518"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="of your daily limit"
            android:textColor="#FF939AA8"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Register checked 2h ago · Take a break"
        android:textColor="#FF939AA8"
        android:textSize="12sp" />
</LinearLayout>
