<?xml version="1.0" encoding="utf-8"?>
<!--
  The picker's card, and only the picker's card.

  The real widgets draw glass with a bitmap (GlassShell), which a static preview layout cannot
  do: previewLayout is inflated by the launcher from a resource, so it gets a shape drawable
  that reads as the same surface. Kept close to GlassShell's 0x9E1A1E28 fill and 0x24FFFFFF
  hairline so the tile the customer taps looks like the widget they get.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#F21A1E28" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="#24FFFFFF" />
</shape>
